#: ../../Residuals/Residuals_Generation_and_Management.rst:300
msgid "Discharge Characteristics and Management"
msgstr ""

#: ../../Residuals/Residuals_Generation_and_Management.rst:305
msgid "Aluminum in Residual Solids"
msgstr ""

#: ../../Residuals/Residuals_Generation_and_Management.rst:307
msgid "Aluminum coagulant contributes aluminum hydroxide to both residual streams. Assuming that all dosed elemental aluminum precipitates and remains in the residual solids, the coagulant-derived elemental-aluminum mass fraction is the elemental-aluminum dose divided by the total dry-solids production. Substituting Equation :eq:`residuals_cube_root_coagulant_dose` and Equation :eq:`residuals_total_solids_turbidity` gives"
msgstr ""

#: ../../Residuals/Residuals_Generation_and_Management.rst:309
msgid "w_{\\mathrm{Al,res}}\n"
"= \\frac{D}{C_s}\n"
"= \\frac{D_{\\mathrm{DOM}}+k_T^D\\sqrt[3]{T_{\\mathrm{in}}}}\n"
"{k_T^C T_{\\mathrm{in}}\n"
"+Y_{\\mathrm{Al}}\\left(D_{\\mathrm{DOM}}+k_T^D\\sqrt[3]{T_{\\mathrm{in}}}\\right)}"
msgstr ""

#: ../../Residuals/Residuals_Generation_and_Management.rst:320
msgid ":math:`w_{\\mathrm{Al,res}}` is the coagulant-derived elemental-aluminum mass fraction of the dry residual solids, in kg Al/kg dry solids;"
msgstr ""

#: ../../Residuals/Residuals_Generation_and_Management.rst:322
msgid ":math:`C_s` is the total dry-solids production per volume of raw water treated, in kg/m³;"
msgstr ""

#: ../../Residuals/Residuals_Generation_and_Management.rst:323
msgid ":math:`D_{\\mathrm{DOM}}` is the additive elemental-aluminum demand associated primarily with dissolved organic matter, in kg Al/m³;"
msgstr ""

