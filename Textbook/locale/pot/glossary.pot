#: ../../glossary.rst:2
msgid "Glossary"
msgstr ""

#: ../../glossary.rst:4
msgid "To add a term to this glossary please add it with the definition in quote marks so that the whole thing is treated as a string rather than further separated by commas."
msgstr ""

#: ../../glossary.rst:1
msgid "Term"
msgstr ""

#: ../../glossary.rst:1
msgid "Definition"
msgstr ""

#: ../../glossary.rst:1
msgid "Alkalinity"
msgstr ""

#: ../../glossary.rst:1
msgid "The ability of a water sample to react with and neutralize an input of acid; also referred to as acid neutralizing capacity (ANC)."
msgstr ""

#: ../../glossary.rst:1
msgid "Backwash"
msgstr ""

#: ../../glossary.rst:1
msgid "The process of pumping water upward through a filter to flush captured particles out of the filter media."
msgstr ""

#: ../../glossary.rst:1
msgid "Baffles"
msgstr ""

#: ../../glossary.rst:1
msgid "Obstructions in the channel of a flocculator that restrain flow in a particular direction."
msgstr ""

#: ../../glossary.rst:1
msgid "Buffer"
msgstr ""

#: ../../glossary.rst:1
msgid "A solution containing a weak acid-base pair that resists pH change by maintaining its hydrogen ion concentration."
msgstr ""

#: ../../glossary.rst:1
msgid "Capture Velocity"
msgstr ""

#: ../../glossary.rst:1
msgid "The velocity of the slowest settling particle that a clarifier can reliably capture."
msgstr ""

#: ../../glossary.rst:1
msgid "Chlorination"
msgstr ""

#: ../../glossary.rst:1
msgid "The process of disinfection in water treatment that uses chlorine compounds to kill bacteria, viruses, and microbes."
msgstr ""

#: ../../glossary.rst:1
msgid "Coagulant"
msgstr ""

#: ../../glossary.rst:1
msgid "A sticky substance added to water to enable particle to attach to each other."
msgstr ""

#: ../../glossary.rst:1
msgid "Collision Potential"
msgstr ""

#: ../../glossary.rst:1
msgid "A measure of the potential for particles in a fluid to hit each other, serving as a performance metric for flocculators with higher values representing better flocculation; the dimensionless product of velocity gradient and residence time."
msgstr ""

#: ../../glossary.rst:1
msgid "Constant Head Tank"
msgstr ""

#: ../../glossary.rst:1
msgid "A container that uses set differences in elevation and a float valve to ensure constant flow."
msgstr ""

#: ../../glossary.rst:1
msgid "Control Volume"
msgstr ""

#: ../../glossary.rst:1
msgid "An imaginary 3-dimensional space with fixed boundaries that remain at steady state."
msgstr ""

#: ../../glossary.rst:1
msgid "Diffusion"
msgstr ""

#: ../../glossary.rst:1
msgid "The net movement of a fluid from an area of higher concentration to an area of lower concentration."
msgstr ""

#: ../../glossary.rst:1
msgid "Dose"
msgstr ""

#: ../../glossary.rst:1
msgid "The concentration of a chemical being added to water undergoing treatment."
msgstr ""

#: ../../glossary.rst:1
msgid "Driving Head"
msgstr ""

#: ../../glossary.rst:1
msgid "An elevation difference that causes a fluid to flow."
msgstr ""

#: ../../glossary.rst:1
msgid "Eddy"
msgstr ""

#: ../../glossary.rst:1
msgid "The swirling of a fluid in turbulent flow that moves in a direction different from the surrounding flow."
msgstr ""

#: ../../glossary.rst:1
msgid "Energy Dissipation Rate"
msgstr ""

#: ../../glossary.rst:1
msgid "The amount of energy lost from viscous forces in turbulent flow; equivalent to head loss in a reactor."
msgstr ""

#: ../../glossary.rst:1
msgid "Floc"
msgstr ""

#: ../../glossary.rst:1
msgid "A cluster of colloidal particles formed through collision and adhesion in the processes of coagulation and flocculation."
msgstr ""

#: ../../glossary.rst:1
msgid "Floc Filter"
msgstr ""

#: ../../glossary.rst:1
msgid "A fluidized layer of flocs that is maintained in the bottom of an upflow clarifier."
msgstr ""

#: ../../glossary.rst:1
msgid "Floc Hopper"
msgstr ""

#: ../../glossary.rst:1
msgid "The collection area in a clarifier where flocs accumulate after overflowing from the floc filter."
msgstr ""

#: ../../glossary.rst:1
msgid "Fractal"
msgstr ""

#: ../../glossary.rst:1
msgid "A geometric structure in which each part shares the characteristics of the whole, forming the same pattern at any scale."
msgstr ""

#: ../../glossary.rst:1
msgid "Friction Factor"
msgstr ""

#: ../../glossary.rst:1
msgid "A dimensionless quantity approximating the magnitude of friction between a fluid and pipe wall, for use in the Darcy-Weisbach equation of major head loss."
msgstr ""

#: ../../glossary.rst:1
msgid "Head Loss"
msgstr ""

#: ../../glossary.rst:1
msgid "Reduction in the energy of a fluid as it flows through a system, including major and minor losses."
msgstr ""

#: ../../glossary.rst:1
msgid "Hydraulic Head"
msgstr ""

#: ../../glossary.rst:1
msgid "The energy of an incompressible fluid expressed as a unit of length representing the height of the fluid in an equivalent static column; the sum of the pressure and elevation terms in the energy equation."
msgstr ""

#: ../../glossary.rst:1
msgid "Inner Viscous Length Scale"
msgstr ""

#: ../../glossary.rst:1
msgid "The order of magnitude where the kinetic energy of small eddies is dissipated by the fluid’s resistance to deformation."
msgstr ""

#: ../../glossary.rst:1
msgid "Kolmogorov Length Scale"
msgstr ""

#: ../../glossary.rst:1
msgid "The order of magnitude where the kinetic energy of turbulence is dominated by viscosity."
msgstr ""

#: ../../glossary.rst:1
msgid "Laminar Flow"
msgstr ""

#: ../../glossary.rst:1
msgid "Fluid particles moving in smooth and highly ordered layers with minimal lateral mixing; flow with a Reynold’s number less than 2,100."
msgstr ""

#: ../../glossary.rst:1
msgid "Linearity Error Ratio"
msgstr ""

#: ../../glossary.rst:1
msgid "The amount of acceptable error in the linear relationship between head and flow."
msgstr ""

#: ../../glossary.rst:1
msgid "Major Loss"
msgstr ""

#: ../../glossary.rst:1
msgid "Energy lost through friction between a fluid and material surfaces."
msgstr ""

#: ../../glossary.rst:1
msgid "Minor Loss"
msgstr ""

#: ../../glossary.rst:1
msgid "Energy lost through the expansion of flow, often pipe fittings."
msgstr ""

#: ../../glossary.rst:1
msgid "Obstacles"
msgstr ""

#: ../../glossary.rst:1
msgid "Obstructions formed by half-pipes that were created by AguaClara to add extra head loss between baffles in a flocculator channel, which makes it possible to design smaller flocculators without compromising efficiency."
msgstr ""

#: ../../glossary.rst:1
msgid "Organic Matter"
msgstr ""

#: ../../glossary.rst:1
msgid "Carbon-based compounds found in the environment."
msgstr ""

#: ../../glossary.rst:1
msgid "pH"
msgstr ""

#: ../../glossary.rst:1
msgid "A measure of the acidity and basicity of a solution, ranging from 0 (acid) to 14 (basic), with neutrality at 7."
msgstr ""

#: ../../glossary.rst:1
msgid "Piezometric Head"
msgstr ""

#: ../../glossary.rst:1
msgid "See Hydraulic Head."
msgstr ""

#: ../../glossary.rst:1
msgid "Plate Settlers"
msgstr ""

#: ../../glossary.rst:1
msgid "A series of inclined plastic sheets that provide a large effective area for particles to accumulate in a clarifier."
msgstr ""

#: ../../glossary.rst:1
msgid "Porosity"
msgstr ""

#: ../../glossary.rst:1
msgid "The ratio of empty volume between individual particles and the total volume of a material."
msgstr ""

#: ../../glossary.rst:1
msgid "Precipitation"
msgstr ""

#: ../../glossary.rst:1
msgid "The process by which a dissolved substance in an aqueous solution forms an insoluble solid."
msgstr ""

#: ../../glossary.rst:1
msgid "Residence Time"
msgstr ""

#: ../../glossary.rst:1
msgid "The amount of time that a fluid spends in a control volume."
msgstr ""

#: ../../glossary.rst:1
msgid "Reynolds Number"
msgstr ""

#: ../../glossary.rst:1
msgid "The ratio of inertial to viscous forces acting on a fluid, indicating that the fluid’s movement is dominated by laminar flow (low Re) or turbulent flow (high Re)."
msgstr ""

#: ../../glossary.rst:1
msgid "Settling Velocity"
msgstr ""

#: ../../glossary.rst:1
msgid "The speed of a particle falling at terminal velocity in a still fluid."
msgstr ""

#: ../../glossary.rst:1
msgid "Shear"
msgstr ""

#: ../../glossary.rst:1
msgid "A type of fluid flow where parallel layers move at different speeds."
msgstr ""

#: ../../glossary.rst:1
msgid "Streamline"
msgstr ""

#: ../../glossary.rst:1
msgid "A line that is parallel to the local velocity vector at all points; the path that a particle would take if it could be placed in the fluid without changing the original flow."
msgstr ""

#: ../../glossary.rst:1
msgid "Suspension"
msgstr ""

#: ../../glossary.rst:1
msgid "A heterogeneous fluid mixture containing particles."
msgstr ""

#: ../../glossary.rst:1
msgid "Sutro Weir"
msgstr ""

#: ../../glossary.rst:1
msgid "A rectangular overflow dam sides that curve parabolically outward at the base causing discharge flow to be proportional to head; also referred to as a proportional weir."
msgstr ""

#: ../../glossary.rst:1
msgid "Terminal Velocity"
msgstr ""

#: ../../glossary.rst:1
msgid "The maximum velocity of a particle falling through fluid, achieved when the drag and buoyancy forces equal gravity."
msgstr ""

#: ../../glossary.rst:1
msgid "Turbidity"
msgstr ""

#: ../../glossary.rst:1
msgid "The optical clarity of water, measured by light scattering off suspended solid particles; turbidity is low in clear water and high in cloudy water."
msgstr ""

#: ../../glossary.rst:1
msgid "Turbulent Flow"
msgstr ""

#: ../../glossary.rst:1
msgid "Fluid particles moving in disordered paths due to chaotic changes in velocity and pressure that lead to mixing; flow with a Reynold’s number greater than 2,100."
msgstr ""

#: ../../glossary.rst:1
msgid "Velocity Gradient"
msgstr ""

#: ../../glossary.rst:1
msgid "A measure of fluid deformation defined by how quickly one point of water along one streamline moves in comparison to another point on another streamline, taking into account the distance between the streamlines."
msgstr ""

#: ../../glossary.rst:1
msgid "Vena Contracta"
msgstr ""

#: ../../glossary.rst:1
msgid "A point of contracting flow with the minimum cross sectional area and maximum velocity."
msgstr ""

#: ../../glossary.rst:1
msgid "Viscosity"
msgstr ""

#: ../../glossary.rst:1
msgid "The resistance of a fluid to flow or deformation, also referred to as the “thickness” of liquid, related to the force applied (dynamic viscosity) or velocity of movement (kinematic viscosity)."
msgstr ""
