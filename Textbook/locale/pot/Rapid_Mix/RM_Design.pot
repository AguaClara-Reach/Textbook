msgstr ""

#: ../../Rapid_Mix/RM_Design.rst:114
msgid "The number of injection ports is 36.0"
msgstr ""

#: ../../Rapid_Mix/RM_Design.rst:115
msgid "The expansion ratio is 5.401 dimensionless"
msgstr ""

#: ../../Rapid_Mix/RM_Design.rst:116
msgid "The width of the contractions is 0.07779 meter"
msgstr ""

#: ../../Rapid_Mix/RM_Design.rst:117
msgid "The diameter of the cylinder is 0.3424 meter"
msgstr ""
