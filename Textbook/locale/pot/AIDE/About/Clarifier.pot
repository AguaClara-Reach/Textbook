#: ../../AIDE/About/Clarifier.rst:1
msgid "Flow (L/s)"
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "The maximum flow rate sets the size of the clarifier. Vary it to see how the dimensions change. Flow rates below 2 L/s create a single clarifier bay and use a different inlet/outlet system."
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "Minimum temperature (˚C)"
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "The temperature influences the design of the inlet manifold."
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "Floc filter velocity (mm/s)"
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "Upflow velocity in the vertical wall section of the floc filter."
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "Plate settler capture velocity (mm/s)"
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "The capture velocity for removal of grit. The clarifier will capture grit that has a terminal velocity faster than this capture velocity. This determines the plan view area of the hoppers in the clarifier."
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "Maximum inlet velocity gradient (1/s)"
msgstr ""

#: ../../AIDE/About/Clarifier.rst:1
msgid "Controls breakup of flocs entering the clarifier. The inlet manifold diameter increases and the diffuser openings increase in width for lower values of the velocity gradient."
msgstr ""

