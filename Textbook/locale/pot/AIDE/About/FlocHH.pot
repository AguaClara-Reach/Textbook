msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Configuration"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Description"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Flow (L/s)"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "The maximum flow rate sets the size of the flocculator. Vary it to see how the dimensions change."
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Minimum temperature (˚C)"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "The water viscosity increases for low temperatures and thus more energy is required (greater head loss) to achieve the same total fluid deformation."
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Water depth at exit (m)"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "The flocculator is built on the same slab as the clarifier and the elevation of the water leaving the flocculator must match the water level at the entrance of the clarifier."
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Collision potential (Gt)"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "The collision potential is created by the total fluid deformation in the flocculator."
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "Velocity gradient (1/s)"
msgstr ""

#: ../../AIDE/About/FlocHH.rst:1
msgid "The velocity gradient influences the size of the flocs leaving the flocculator. High velocity gradients all require more energy input (more head loss)."
msgstr ""

