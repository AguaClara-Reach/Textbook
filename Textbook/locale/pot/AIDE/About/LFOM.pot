#: ../../AIDE/About/LFOM.rst:38
msgid "Linear Flow Orifice Meter configuration parameters."
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Configuration"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Description"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Flow (L/s)"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "The maximum flow rate sets the size of the Linear Flow Orifice Meter. Vary it to see how the dimensions change."
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Minimum temperature (˚C)"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "The flow is turbulent throughout the Linear Flow Orifice Meter and thus temperature doesn’t have a significant effect on the design."
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Water elevation range (m)"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Change in water elevation in the entrance tank that corresponds to the flow varying from 0 L/s up to the maximum design flow rate."
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Maximum drill diameter (m)"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Used to limit the drill bit size required to fabricate the LFOM."
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Maximum nominal diameter (inch)"
msgstr ""

#: ../../AIDE/About/LFOM.rst:1
msgid "Used to set a maximum pipe size. For higher flow rates the LFOM will increase the water elevation range so the pipe can carry more flow."
msgstr ""

