msgid "Flocculator baffle"
msgstr "Deflector del floculador"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "0.0124"
msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ""
":math:`\\varepsilon_{max} = \\Pi_{FlocBaffle} \\frac{  \\bar v_{Jet} "
