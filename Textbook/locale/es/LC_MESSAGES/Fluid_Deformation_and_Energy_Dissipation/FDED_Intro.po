#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:123
msgid ""
"Equations for maximum energy dissipation rates and velocity gradients for "
"flow expansions."
msgstr ""
"Ecuaciones para tasas máximas de disipación de energía y gradientes de "
"velocidad para expansiones de flujo."

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ":math:`Pi_{Jet}`"
msgstr ":math:`Pi_{Jet}`"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "Maximum energy dissipation rate"
msgstr "Tasa máxima de disipación de energía"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "Maximum velocity gradient"
msgstr "Gradiente máximo de velocidad"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "Round jet"
msgstr "Chorro redondo"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "0.08"
msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ""
":math:`\\varepsilon_{max} = \\Pi_{JetRound}\\frac{  \\bar v_{Jet} "
