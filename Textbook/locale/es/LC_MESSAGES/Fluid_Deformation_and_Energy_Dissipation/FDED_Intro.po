msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "Plane jet"
msgstr "Jet de avión"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "0.04"
msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ""
":math:`\\varepsilon_{max} = \\Pi_{JetPlane} \\frac{  \\bar v_{Jet} "
"^3}{S_{Jet}}`"
msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ""
":math:`G_{max} = \\bar v_{Jet}\\sqrt{\\frac{\\Pi_{JetPlane} \\bar "
"v_{Jet}}{\\nu S_{Jet}}}`"
msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid "Behind a flat plate"
msgstr "Detrás de una placa plana"

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ":math:`\\varepsilon _{max} = \\Pi_{Plate}\\frac{\\bar v^3}{W_{Plate}}`"
msgstr ""

#: ../../Fluid_Deformation_and_Energy_Dissipation/FDED_Intro.rst:1
msgid ":math:`G_{max} = \\bar v\\sqrt{\\frac{\\Pi_{Plate} \\bar v}{\\nu W_{Plate}}}`"
msgstr ""

