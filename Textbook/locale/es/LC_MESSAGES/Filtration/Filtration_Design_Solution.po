#: ../../Filtration/Filtration_Design_Solution.rst:154
msgid "Mass conservation gives"
msgstr "La conservación masiva da"

#: ../../Filtration/Filtration_Design_Solution.rst:156
msgid ""
"Vol_{Floc} \\cdot \\rho_{Floc} = M_{Clay} + M_{Water}\n"
"\n"
msgstr ""
"Vol_{Floc} \\cdot \\rho_{Floc} = M_{Clay} + M_{Water}\n"
"\n"

#: ../../Filtration/Filtration_Design_Solution.rst:158
msgid ":math:`M_{Water}` is an unknown."
msgstr ":math:`M_{Water}` es una incógnita."

#: ../../Filtration/Filtration_Design_Solution.rst:160
msgid ""
"M_{Water} = Vol_{Floc} \\cdot \\rho{Floc} - M_{Clay}\n"
"\n"
msgstr ""
"M_{Water} = Vol_{Floc} \\cdot \\rho{Floc} - M_{Clay}\n"
"\n"

#: ../../Filtration/Filtration_Design_Solution.rst:162
msgid "Volume conservation gives"
msgstr "La conservación de volumen da"

#: ../../Filtration/Filtration_Design_Solution.rst:164
msgid ""
"Vol_{Floc} = Vol_{Clay} + Vol_{Water}\n"
"\n"
msgstr ""
"Vol_{Floc} = Vol_{Clay} + Vol_{Water}\n"
"\n"

#: ../../Filtration/Filtration_Design_Solution.rst:166
msgid ""
"Vol_{Floc} = \\frac{M_{Clay}}{\\rho_{Clay}} + "
"\\frac{M_{Water}}{\\rho_{Water}}\n"
"\n"
msgstr ""

#: ../../Filtration/Filtration_Design_Solution.rst:168
msgid "Substitute to eliminate :math:`M_{Water}`"
msgstr "Sustituye para eliminar :math:`M_{Water}`"

#: ../../Filtration/Filtration_Design_Solution.rst:170
msgid ""
"Vol_{Floc} = \\frac{M_{Clay}}{\\rho_{Clay}} + \\frac{Vol_{Floc} \\cdot "
"\\rho_{Floc}}{\\rho_{Water}} -\\frac{M_{Clay}}{\\rho_{Water}}\n"
"\n"
msgstr ""

#: ../../Filtration/Filtration_Design_Solution.rst:172
msgid "Solve for :math:`Vol_{Floc}`"
msgstr "Resuelve :math:`Vol_{Floc}`"

#: ../../Filtration/Filtration_Design_Solution.rst:174
msgid ""
"Vol_{Floc} - \\frac{Vol_{Floc} \\cdot \\rho_{Floc}}{\\rho_{Water}} = "
"\\frac{M_{Clay}}{\\rho_{Clay}} - \\frac{M_{Clay}}{\\rho_{Water}}\n"
"\n"
msgstr ""

#: ../../Filtration/Filtration_Design_Solution.rst:176
msgid ""
"Vol_{Floc}\\left ( 1-\\frac{\\rho_{Floc}}{\\rho_{Water}} \\right ) = "
"M_{Clay}\\left ( \\frac{1}{\\rho_{Clay}} -\\frac{1}{\\rho_{Water}}\\right )"
"\n"
"\n"
msgstr ""

#: ../../Filtration/Filtration_Design_Solution.rst:178
msgid ""
"Vol_{Floc} = M_{Clay}\\left ( "
"\\frac{\\frac{1}{\\rho_{Clay}}-\\frac{1}{\\rho_{Water}}}{ "
"1-\\frac{\\rho_{Floc}}{\\rho_{Water}}} \\right )\n"
"\n"
msgstr ""

#: ../../Filtration/Filtration_Design_Solution.rst:180
msgid ""
"Vol_{Floc} = { "
"\\frac{M_{Clay}\\rho_{Water}}{\\rho_{Floc}-\\rho_{Water}}}\\left ( "
"\\frac{1}{\\rho_{Water}}-\\frac{1}{\\rho_{Clay}} \\right )\n"
"\n"
msgstr ""

