"\\rho_{floc} \\forall_{floc} =\n"
"\\rho_{H_2O} \\forall_{floc} - \\rho_{H_2O}\\forall_{n_{cp}} + \\rho_{cp} "
"\\forall_{n_{cp}}"
msgstr ""
"\\rho_{floc} \\forall_{floc} =\n"
"\\rho_{H_2O} \\forall_{floc} - \\rho_{H_2O}\\forall_{n_{cp}} + \\rho_{cp} "
"\\forall_{n_{cp}}"

