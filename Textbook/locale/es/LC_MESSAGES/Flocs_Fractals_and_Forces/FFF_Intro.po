msgstr "F_{buoyant} = \\forall_{floc} \\rho_{H_2O} g"

#: ../../Flocs_Fractals_and_Forces/FFF_Intro.rst:198
msgid "The weight of the sphere is given by:"
msgstr "El peso de la esfera se da por:"

#: ../../Flocs_Fractals_and_Forces/FFF_Intro.rst:200
msgid "W_{floc} = \\forall_{floc} \\rho_{floc} g"
msgstr "W_{floc} = \\forall_{floc} \\rho_{floc} g"

#: ../../Flocs_Fractals_and_Forces/FFF_Intro.rst:205
#: ../../Flocs_Fractals_and_Forces/FFF_Intro.rst:294
msgid "Where:"
msgstr "Donde:"

#: ../../Flocs_Fractals_and_Forces/FFF_Intro.rst:206
