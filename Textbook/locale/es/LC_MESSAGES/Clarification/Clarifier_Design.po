msgid ""
"Thickness of the jet exiting the reverser from Equation "
":eq:`planejet_S_of_q`."
msgstr "Grosor del chorro que sale del inversor de la ecuación :eq:`planejet_S_of_q`."

#: ../../Clarification/Clarifier_Design.rst:350
msgid "Diffuser center to center spacing from Equation :eq:`diffuser_B`."
msgstr "Espaciado centro a centro del difusor desde la ecuación :eq:`diffuser_B`."

